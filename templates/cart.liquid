{% assign product_handle = settings.product_handle | default: 'handmade-artistic-fruit-stand-functional-design-for-modern-homes' %}
{% assign product = all_products[product_handle] %}
{% assign variant = product.selected_or_first_available_variant %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Redirecting to checkout...</title>
  {% if product and variant %}
    <meta http-equiv="refresh" content="0;url=/checkout">
  {% else %}
    <meta http-equiv="refresh" content="3;url=/">
  {% endif %}
  <style>
    body { font-family: Arial, sans-serif; display:flex; align-items:center; justify-content:center; min-height:100vh; background:#f8f6f3; color:#181614; }
    .card { background:#fff; padding:2rem; border-radius:14px; box-shadow:0 18px 36px rgba(0,0,0,0.08); max-width:420px; text-align:center; }
    .btn { display:inline-flex; align-items:center; justify-content:center; padding:0.85rem 1.2rem; background:#1f1b16; color:#fff; border-radius:999px; text-decoration:none; font-weight:600; }
  </style>
</head>
<body>
  <div class="card">
    {% if product and variant %}
      <p>Adding your Handmade Artistic Fruit Stand and sending you to secure checkout...</p>
      <form id="direct-checkout" action="/cart/add" method="post">
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="return_to" value="/checkout">
      </form>
      <noscript>
        <button class="btn" type="submit" form="direct-checkout">Continue to checkout</button>
      </noscript>
      <script>
        window.addEventListener('load', function() {
          document.getElementById('direct-checkout').submit();
        });
      </script>
    {% else %}
      <p>We couldn't find the product. Please continue to the landing page to shop.</p>
      <a class="btn" href="/">Back to home</a>
    {% endif %}
  </div>
</body>
</html>
