{% comment %}
  Cart page displaying current line items with ability to update quantities or proceed to checkout.
{% endcomment %}

{% if cart.item_count == 0 %}
  <section class="cart cart--empty">
    <div class="cart__header">
      <p class="eyebrow">Your cart</p>
      <h1>Nothing here yet</h1>
      <p class="cart__subtext">Browse the collection to add the handcrafted fruit stand to your home.</p>
      <a class="btn" href="/">Continue shopping</a>
    </div>
  </section>
{% else %}
  <section class="cart">
    <div class="cart__header">
      <p class="eyebrow">Your cart</p>
      <h1>Ready for checkout</h1>
      <p class="cart__subtext">Review your items, adjust quantities, and continue to secure checkout.</p>
    </div>

    <form action="/cart" method="post" class="cart__form">
      <div class="cart__items" role="list">
        {% for item in cart.items %}
          <article class="cart-item" role="listitem">
            {% if item.image %}
              <a class="cart-item__image" href="{{ item.url }}">
                <img src="{{ item.image | image_url: width: 360 }}" alt="{{ item.title | escape }}">
              </a>
            {% endif %}
            <div class="cart-item__info">
              <div class="cart-item__title">
                <h2>{{ item.product.title }}</h2>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endunless %}
              </div>
              <div class="cart-item__meta">
                <div class="cart-item__price">
                  {{ item.final_price | money }}
                </div>
                <label class="cart-item__quantity" for="updates-{{ forloop.index }}">
                  <span>Quantity</span>
                  <input id="updates-{{ forloop.index }}" name="updates[{{ item.key }}]" type="number" min="0" value="{{ item.quantity }}">
                </label>
                <div class="cart-item__line">
                  {{ item.final_line_price | money }}
                </div>
              </div>
              <button type="submit" name="updates[{{ item.key }}]" value="0" class="cart-item__remove">Remove</button>
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="cart__summary">
        <div class="cart__totals">
          <div class="cart__subtotal">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart__note">Shipping and taxes calculated at checkout.</p>
        </div>
        <div class="cart__actions">
          <a class="cart__continue" href="/">Continue shopping</a>
          <div class="cart__action-buttons">
            <button type="submit" name="update" class="btn btn-secondary">Update cart</button>
            <button type="submit" name="checkout" class="btn">Checkout</button>
          </div>
        </div>
      </div>
    </form>
  </section>
{% endif %}
