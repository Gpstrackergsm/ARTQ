{% assign product_handle = settings.product_handle | default: 'the-highly-sensitive-person-how-to-thrive-when-the-world-overwhelms-you' %}
{% assign product = all_products[product_handle] %}
{% assign primary_variant = product.selected_or_first_available_variant %}
<section class="hero" id="top">
  <div class="hero__copy">
    <p class="eyebrow">National Bestseller · Psychology Classic</p>
    <h1>The Highly Sensitive Person: How to Thrive When the World Overwhelms You</h1>
    <p class="lede">Dr. Elaine Aron’s compassionate handbook shows Highly Sensitive People how to honor their trait, set gentle boundaries, and design a life that feels calm, meaningful, and connected.</p>
    <div class="rating-row">
      <span class="pill">⭐ 4.5/5 from 10,498 readers</span>
      <span class="pill">3.8 on Goodreads · 53,848 ratings</span>
      <span class="pill">Updated research + new author note</span>
    </div>
    <div class="cta-group">
      {% if product != blank and primary_variant %}
        {% form 'product', product, id: 'hero-buy-now' %}
          <input type="hidden" name="id" value="{{ primary_variant.id }}">
          <button type="submit" name="checkout" class="btn btn-primary">Buy Now — {{ primary_variant.price | money_without_trailing_zeros }}</button>
        {% endform %}
      {% else %}
        <a class="btn btn-primary" href="/checkout">Buy Now — $29</a>
      {% endif %}
      <p class="urgency">Instant digital access · No shipping required · 30-day satisfaction promise</p>
      <div class="badges">
        <span>✔ Read on any device</span>
        <span>✔ Includes self-assessment tools</span>
        <span>✔ Trusted by therapists & readers</span>
      </div>
    </div>
  </div>
  <div class="hero__image">
    <img src="https://cdn.shopify.com/s/files/1/0989/7020/6389/files/81C1VUgFP_L._SL1500.jpg?v=1765371942" alt="Cover of The Highly Sensitive Person book" loading="eager">
    <div class="countdown" data-countdown-hours="48">
      <p>Limited-time bonus</p>
      <div class="countdown__timer" id="countdown-timer">48:00:00</div>
      <p class="subtle">Get a free reflection worksheet with your order</p>
    </div>
  </div>
</section>

<section class="summary">
