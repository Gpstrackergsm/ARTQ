        <p class="stat">Self-tests, coping plans, relationship scripts</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Formats</p>
        <p class="stat">Paperback, Kindle, and audiobook friendly</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Who it helps</p>
        <p class="stat">HSPs, partners, parents, therapists, and team leads</p>
      </div>
    </div>
  </div>
</section>

<section class="features">
