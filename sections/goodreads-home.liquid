{% liquid
  assign psychology_collection = collections['all']
  assign product_1 = psychology_collection.products[0]
  assign product_2 = psychology_collection.products[1]

  assign variant_1 = product_1.selected_or_first_available_variant
  assign variant_2 = product_2.selected_or_first_available_variant

  assign buy_now_1 = '/checkout'
  assign buy_now_2 = '/checkout'

  if product_1 and variant_1
    assign buy_now_1 = routes.cart_add_url | append: '?id=' | append: variant_1.id | append: '&quantity=1&return_to=/checkout'
  endif

  if product_2 and variant_2
    assign buy_now_2 = routes.cart_add_url | append: '?id=' | append: variant_2.id | append: '&quantity=1&return_to=/checkout'
  endif
%}

<section class="psy-hero" id="top">
  <div class="psy-hero__content">
    <p class="psy-eyebrow">Psychology books for calm, clarity, and growth</p>
    <h1>Nurture your mind with expert-led reading</h1>
    <p class="psy-lede">Dive into the psychology classics readers trust to navigate sensitivity, anxiety, and everyday overwhelm. Every page is designed to help you feel understood and supported.</p>
    <div class="psy-cta-row">
      {% if product_1 and variant_1 %}
        <a class="psy-btn psy-btn-primary" href="{{ buy_now_1 }}">Buy Now: {{ product_1.title }}</a>
      {% endif %}
      {% if product_2 and variant_2 %}
        <a class="psy-btn psy-btn-secondary" href="{{ buy_now_2 }}">Buy Now: {{ product_2.title }}</a>
      {% endif %}
    </div>
    <p class="psy-trust">Free U.S. shipping · Secure checkout · Therapist-recommended titles</p>
  </div>
  <div class="psy-hero__badge">
    <p>Curated by mental health coaches</p>
    <p>Built for highly sensitive readers</p>
  </div>
</section>

<section class="psy-grid" id="books">
  <div class="psy-section__header">
    <p class="psy-eyebrow">Featured in the shop</p>
    <h2>Psychology bestsellers, ready to ship</h2>
    <p class="psy-lede">Choose the book that meets you where you are. Each title includes simple exercises, reflection prompts, and science-backed guidance.</p>
  </div>

  <div class="psy-card__grid">
    {% if product_1 %}
      <article class="psy-card">
        <div class="psy-card__image">
          {% if product_1.featured_image %}
            {{ product_1.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product_1.title }}
          {% endif %}
        </div>
        <div class="psy-card__body">
          <p class="psy-eyebrow">Emotional resilience</p>
          <h3>{{ product_1.title }}</h3>
          <p class="psy-card__copy">{{ product_1.description | strip_html | truncate: 180 }}</p>
          {% if variant_1 %}
            <p class="psy-price">{{ variant_1.price | money_without_trailing_zeros }}</p>
          {% endif %}
          <a class="psy-btn psy-btn-primary" href="{{ buy_now_1 }}">Buy Now</a>
        </div>
      </article>
    {% endif %}

    {% if product_2 %}
      <article class="psy-card">
        <div class="psy-card__image">
          {% if product_2.featured_image %}
            {{ product_2.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product_2.title }}
          {% endif %}
        </div>
        <div class="psy-card__body">
          <p class="psy-eyebrow">Calm & boundaries</p>
          <h3>{{ product_2.title }}</h3>
          <p class="psy-card__copy">{{ product_2.description | strip_html | truncate: 180 }}</p>
          {% if variant_2 %}
            <p class="psy-price">{{ variant_2.price | money_without_trailing_zeros }}</p>
          {% endif %}
          <a class="psy-btn psy-btn-primary" href="{{ buy_now_2 }}">Buy Now</a>
        </div>
      </article>
    {% endif %}
  </div>
</section>

<section class="psy-benefits" id="why">
  <div class="psy-section__header">
    <p class="psy-eyebrow">Why these books?</p>
    <h2>Grounded in psychology, written for real life</h2>
    <p class="psy-lede">Both titles are penned by trusted psychologists and coaches, blending research with relatable stories so you can apply every insight immediately.</p>
  </div>
  <div class="psy-benefits__grid">
    <div class="psy-benefit">
      <h3>Evidence-based tools</h3>
      <p>Practical frameworks for managing overwhelm, regulating emotions, and building supportive routines.</p>
      {% if product_1 %}<a class="psy-link" href="{{ buy_now_1 }}">Buy now</a>{% endif %}
    </div>
    <div class="psy-benefit">
      <h3>Gentle guidance</h3>
      <p>Warm tone, clear steps, and exercises that respect sensitivity while encouraging progress.</p>
      {% if product_2 %}<a class="psy-link" href="{{ buy_now_2 }}">Buy now</a>{% endif %}
    </div>
    <div class="psy-benefit">
      <h3>Immediate support</h3>
      <p>Order today and head straight to checkout—no endless browsing, just the resources you need.</p>
      {% if product_1 %}<a class="psy-link" href="{{ buy_now_1 }}">Buy now</a>{% endif %}
    </div>
  </div>
</section>

<section class="psy-guarantee" id="guarantee">
  <div class="psy-guarantee__content">
    <div>
      <p class="psy-eyebrow">Peace-of-mind purchase</p>
      <h2>Secure checkout and fast delivery</h2>
      <p>Both books ship quickly, include easy returns, and lead you straight to a calmer nervous system. Click any button to head directly to checkout.</p>
    </div>
    <div class="psy-guarantee__actions">
      {% if product_1 and variant_1 %}
        <a class="psy-btn psy-btn-primary" href="{{ buy_now_1 }}">Buy Now: {{ product_1.title }}</a>
      {% endif %}
      {% if product_2 and variant_2 %}
        <a class="psy-btn psy-btn-secondary" href="{{ buy_now_2 }}">Buy Now: {{ product_2.title }}</a>
      {% endif %}
    </div>
  </div>
</section>

<footer class="psy-footer">
  <p>Ready to feel calmer? Tap any button to purchase your psychology book now.</p>
  {% if product_1 %}<a class="psy-btn psy-btn-primary" href="{{ buy_now_1 }}">Buy Now</a>{% endif %}
</footer>

{% schema %}
{
  "name": "Psychology books landing",
  "settings": []
}
{% endschema %}
