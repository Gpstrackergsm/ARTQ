<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {% liquid
    assign default_title = 'The Highly Sensitive Person: How to Thrive When the World Overwhelms You'
    assign default_description = 'Dr. Elaine Aron’s compassionate handbook shows Highly Sensitive People how to honor their trait, set gentle boundaries, and design a life that feels calm, meaningful, and connected.'
    assign default_handle = settings.product_handle | default: 'the-highly-sensitive-person-how-to-thrive-when-the-world-overwhelms-you'
    assign meta_product = all_products[default_handle]
    assign meta_image = 'https://cdn.shopify.com/static/images/placeholder-square.png'
    assign meta_url = shop.url
    assign primary_variant = nil

    if meta_product
      assign primary_variant = meta_product.selected_or_first_available_variant

      if meta_product.title != blank
        assign default_title = meta_product.title
      endif

      if meta_product.description != blank
        assign default_description = meta_product.description | strip_html | truncate: 160
      endif

      if meta_product.url
        assign meta_url = shop.url | append: meta_product.url
      endif

      if meta_product.featured_image
        assign meta_image = meta_product.featured_image | image_url: width: 1200
      endif
    endif
  %}
  <title>{{ default_title }}</title>
  <meta name="description" content="{{ default_description }}">
  <meta property="og:title" content="{{ default_title }}">
  <meta property="og:description" content="{{ default_description }}">
  <meta property="og:type" content="product">
  <meta property="og:image" content="{{ meta_image }}">
  <meta property="og:url" content="{{ meta_url }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    document.documentElement.style.scrollBehavior = 'smooth';
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "{{ default_title }}",
      "image": ["{{ meta_image }}"],
      "description": "{{ default_description }}",
      "sku": "{{ primary_variant.sku | default: 'dsm-5-tr' }}",
      "brand": {"@type": "Brand", "name": "APA Publishing"},
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "price": "{{ primary_variant.price | default: 0 | divided_by: 100.0 }}",
        "availability": "http://schema.org/InStock",
        "url": "{{ meta_url }}"
      }
    }
  </script>
  {{ content_for_header }}
</head>
<body class="leafanoo-body">
  <main role="main">
    {{ content_for_layout }}
  </main>
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
