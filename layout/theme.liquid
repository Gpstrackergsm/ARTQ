<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- assign default_title = 'Handmade Artistic Fruit Stand — Functional Design for Modern Homes' -%}
  {%- assign default_description = 'Leafanoo presents a handcrafted, sculptural fruit stand that elevates countertops with a modern, functional aesthetic.' -%}
  <title>{{ default_title }}</title>
  <meta name="description" content="{{ default_description }}">
  <meta property="og:title" content="{{ default_title }}">
  <meta property="og:description" content="{{ default_description }}">
  <meta property="og:type" content="product">
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0989/7020/6389/files/IMG_1752.jpg?v=1765054741">
  <meta property="og:url" content="{{ shop.url }}">
  <meta name="twitter:card" content="summary_large_image">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    document.documentElement.style.scrollBehavior = 'smooth';
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Handmade Artistic Fruit Stand — Functional Design for Modern Homes",
      "image": ["https://cdn.shopify.com/s/files/1/0989/7020/6389/files/IMG_1752.jpg?v=1765054741"],
      "description": "Leafanoo handcrafted fruit stand combining artful sculpture with everyday function for elevated kitchens.",
      "sku": "leafanoo-fruit-stand",
      "brand": {"@type": "Brand", "name": "Leafanoo"},
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "price": "49",
        "availability": "http://schema.org/InStock",
        "url": "{{ shop.url }}/products/handmade-artistic-fruit-stand-functional-design-for-modern-homes"
      }
    }
  </script>
  {{ content_for_header }}
</head>
<body class="leafanoo-body">
  <main role="main">
    {{ content_for_layout }}
  </main>
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
