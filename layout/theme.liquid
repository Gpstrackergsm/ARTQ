<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- assign default_title = 'The Highly Sensitive Person — Thrive When the World Overwhelms You' -%}
  {%- assign default_description = 'Elaine Aron’s national bestseller for highly sensitive people: understand your trait, protect your energy, and create a life that fits.' -%}
  <title>{{ default_title }}</title>
  <meta name="description" content="{{ default_description }}">
  <meta property="og:title" content="{{ default_title }}">
  <meta property="og:description" content="{{ default_description }}">
  <meta property="og:type" content="product">
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0989/7020/6389/files/81C1VUgFP_L._SL1500.jpg?v=1765371942">
  <meta property="og:url" content="{{ shop.url }}">
  <meta name="twitter:card" content="summary_large_image">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    document.documentElement.style.scrollBehavior = 'smooth';
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "The Highly Sensitive Person: How to Thrive When the World Overwhelms You",
      "image": ["https://cdn.shopify.com/s/files/1/0989/7020/6389/files/81C1VUgFP_L._SL1500.jpg?v=1765371942"],
      "description": "National bestseller by Dr. Elaine Aron with assessments, coping tools, and relationship guidance for highly sensitive people.",
      "sku": "hsp-book-paperback",
      "brand": {"@type": "Brand", "name": "Dr. Elaine Aron"},
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "price": "17",
        "availability": "http://schema.org/InStock",
        "url": "{{ shop.url }}/products/the-highly-sensitive-person-how-to-thrive-when-the-world-overwhelms-you"
      }
    }
  </script>
  {{ content_for_header }}
</head>
<body class="leafanoo-body">
  <main role="main">
    {{ content_for_layout }}
  </main>
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
